#!/bin/zsh
# openbrain: Main Thing adapter for Open Brain. Runs when a task with a ref
# "openbrain:<id>" is completed in the notch, the API or the CLI.
#
#   openbrain complete <id>    mark Open Brain task <id> done, via `ob task done <id>`
#
# Needs the Open Brain CLI (`ob`) and OPEN_BRAIN_API_URL plus OPEN_BRAIN_API_KEY.
# When ~/.config/mainthing/openbrain.env exists and the key is not already in the
# environment, the script re-runs itself through `op run --env-file`, so the file
# can hold 1Password references (op://...) instead of secrets. The id alone names
# the task; no garden or project is needed. The event payload on stdin is ignored.
#
# Install:  ln -s "$PWD/adapters/openbrain" ~/.config/mainthing/adapters/openbrain
set -u

# The app runs adapters with a small PATH. Add the usual homes of `ob` and `op`.
path=("$HOME/.volta/bin" "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin $path)

config="${XDG_CONFIG_HOME:-$HOME/.config}/mainthing"
env_file="$config/openbrain.env"

if [[ -z "${OPEN_BRAIN_API_KEY:-}" && -f "$env_file" ]]; then
    command -v op >/dev/null || { echo "openbrain: $env_file exists but the 1Password CLI (op) is not on PATH" >&2; exit 1; }
    exec op run --env-file "$env_file" -- "$0" "$@"
fi

verb="${1:-}"
case "$verb" in
    complete)
        id="${2:-}"
        [[ -n "$id" ]] || { echo "usage: openbrain complete <id>" >&2; exit 2; }
        [[ -n "${OPEN_BRAIN_API_URL:-}" ]] || { echo "openbrain: OPEN_BRAIN_API_URL is not set (put it in $env_file)" >&2; exit 1; }
        [[ -n "${OPEN_BRAIN_API_KEY:-}" ]] || { echo "openbrain: OPEN_BRAIN_API_KEY is not set (put an op:// reference in $env_file)" >&2; exit 1; }
        command -v ob >/dev/null || { echo "openbrain: the Open Brain CLI (ob) is not on PATH" >&2; exit 1; }
        exec ob task done "$id"
        ;;
    -h|--help|help)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    "")
        echo "usage: openbrain complete <id>" >&2
        exit 2
        ;;
    *)
        echo "openbrain: unknown verb '$verb'. Only: complete <id>" >&2
        exit 2
        ;;
esac
