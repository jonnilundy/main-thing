#!/bin/bash
# mainthing: talk to the Main Thing notch over its local API. `mainthing help` has the reference.
set -u

HOST=mainthing.localhost
PORT="${MAINTHING_PORT:-}"
BASE=""
BUNDLE_ID=com.jonnilundy.mainthing

fail() { echo "mainthing: $*" >&2; exit 1; }

not_running() {
    fail "Main Thing is not running on port $PORT. Start the app, or set MAINTHING_PORT."
}

# True when a Main Thing answers GET /health at the base URL.
is_mainthing() {
    local body
    body=$(curl -s --max-time 1 "$1/health" 2>/dev/null) || return 1
    [[ "$body" == *'"ok":true'* && "$body" == *'"version"'* ]]
}

# The port pinned with `mainthing port <n>`, or nothing.
pinned_port() { defaults read "$BUNDLE_ID" port 2>/dev/null; }

# Sets BASE: the port from MAINTHING_PORT when set, else the first of the pinned port, 80 and 7788 where the app answers.
find_base() {
    [[ -z "$BASE" ]] || return 0
    if [[ -n "$PORT" ]]; then
        BASE="http://$HOST:$PORT"
        return 0
    fi
    local candidate pinned
    pinned=$(pinned_port)
    for candidate in ${pinned:+"http://$HOST:$pinned"} "http://$HOST" "http://$HOST:7788"; do
        if is_mainthing "$candidate"; then
            BASE="$candidate"
            return 0
        fi
    done
    fail "Main Thing is not running. Tried $HOST on port ${pinned:+$pinned, }80 and 7788. Start the app, or set MAINTHING_PORT."
}

# The full reference. Agents read this.
help() {
    cat <<'EOF'
mainthing: the task list in the Main Thing notch, over its local API.

  mainthing                  print the current task
  mainthing list             one task per line
  mainthing list --json      the tasks as JSON, [{"title":"A","ref":"x:1"},{"title":"B"}]
  mainthing set "A" "B"      replace the list
  mainthing set -            replace the list, one task per line on stdin
  mainthing set --json -     replace the list from a JSON array on stdin
  mainthing done             mark the current task done
  mainthing done 3           mark the third task done
  mainthing adapters         installed adapters and their last run
  mainthing hooks            installed hooks and their last run
  mainthing health           is the app up, and on which port
  mainthing version          the app version
  mainthing logs             stream the app log
  mainthing port [n|auto]    show or set the port, then relaunch the app
  mainthing help             this text

The list is ordered. The first task is the one in the notch.
set and done take --source <name> to say who made the change, default cli.

JSON: an array of strings or {"title":"...","ref":"..."} objects. A ref ties a task to the
same task in another tool, "<adapter>:<id>", for example "openbrain:qh75pbc". Keep it when
you rewrite the list. Completing that task then closes it in the other tool too.

HTTP, at http://mainthing.localhost (port 80), or http://mainthing.localhost:7788:
  GET  /tasks        the list, {"tasks":[{"title":"A","ref":"x:1"},{"title":"B"}]}
  PUT  /tasks        replace the list; body: a JSON array as above; answers with the list
  POST /tasks/done   complete the first task; body {"index":N} (0 based) or {"ref":"x:1"} picks another
  GET  /status       installed hooks and adapters with their last run
  GET  /health       {"ok":true,"port":80,"version":"0.1.0"}
?source=<name> on PUT and POST names the caller. Loopback only. A request with an Origin
header is refused. Bad JSON is 400, a task that is not there is 404.
EOF
}

# GET or PUT or POST; prints the body, exits 1 with a clear message when the app is down.
call() {
    local method="$1" path="$2" body="${3-}"
    local out rc
    find_base
    if [[ -n "$body" ]]; then
        out=$(curl -s -S --max-time 3 -X "$method" --data-binary "$body" -w $'\n%{http_code}' "$BASE$path" 2>&1)
    else
        out=$(curl -s -S --max-time 3 -X "$method" -w $'\n%{http_code}' "$BASE$path" 2>&1)
    fi
    rc=$?
    [[ $rc -eq 7 || $rc -eq 28 ]] && not_running
    [[ $rc -ne 0 ]] && fail "curl failed: $out"
    local status="${out##*$'\n'}"
    local payload="${out%$'\n'*}"
    if [[ "$status" != "200" ]]; then
        fail "HTTP $status: $payload"
    fi
    printf '%s' "$payload"
}

# JSON string literal for one title. Escapes backslash, quote and control characters.
json_string() {
    local s="$1"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '"%s"' "$s"
}

# JSON array from the arguments.
json_array() {
    local out="[" first=1 t
    for t in "$@"; do
        [[ $first -eq 1 ]] || out+=","
        out+=$(json_string "$t")
        first=0
    done
    printf '%s]' "$out"
}

# Run a JavaScript expression over the parsed {"tasks":[...]} body on stdin. JavaScript for Automation ships with macOS.
jsbody() {
    osascript -l JavaScript -e '
        ObjC.import("Foundation");
        const data = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
        const text = $.NSString.alloc.initWithDataEncoding(data, $.NSUTF8StringEncoding).js;
        const body = JSON.parse(text);
        '"$1"'
    ' 2>/dev/null
}

# Titles, one per line.
titles() { jsbody 'body.tasks.map(t => t.title).join("\n");'; }

# The tasks as a JSON array of objects, the same shape `set --json -` reads.
tasks_json() { jsbody 'JSON.stringify(body.tasks);'; }

# One line per installed hook or adapter from a GET /status body: name, state, last run.
installed() {
    jsbody '
        const rows = body["'"$1"'"];
        if (rows.length === 0) "none installed in ~/.config/mainthing/'"$1"'";
        else rows.map(r => {
            const state = r.problem ? "skipped: " + r.problem : "ok";
            const run = r.lastRun
                ? "last run " + r.lastRun.at + " " + (r.lastRun.timedOut ? "killed after " : "exit " + r.lastRun.exit + " in ") + r.lastRun.ms + " ms" + (r.lastRun.ok ? "" : " FAILED") + (r.lastRun.stderr ? "\n    " + r.lastRun.stderr.split("\n").join("\n    ") : "")
                : "never run";
            return r.name + "  " + state + "  " + run;
        }).join("\n");
    '
}

# --source <name> from the front of the arguments. Sets SOURCE and leaves the rest in REST.
SOURCE=cli
REST=()
take_source() {
    REST=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--source" ]]; then
            [[ -n "${2-}" ]] || fail "--source needs a name, for example --source agent"
            SOURCE="$2"; shift 2
        else
            REST+=("$1"); shift
        fi
    done
}

cmd="${1-current}"
case "$cmd" in
    current)
        first=$(call GET /tasks | titles | head -n 1)
        [[ -n "$first" ]] && echo "$first"
        ;;
    list)
        if [[ "${2-}" == "--json" ]]; then
            call GET /tasks | tasks_json
        else
            call GET /tasks | titles
        fi
        ;;
    set)
        shift
        take_source "$@"
        set -- "${REST[@]+"${REST[@]}"}"
        json=0
        while [[ "${1-}" == --* ]]; do
            case "$1" in
                --json) json=1; shift ;;
                *) fail "unknown option '$1' for set. Try: mainthing set \"A\" \"B\", mainthing set -, mainthing set --json -, mainthing set --source agent ..." ;;
            esac
        done
        if [[ $json -eq 1 ]]; then
            [[ "${1-}" == "-" ]] || fail "set --json reads the JSON array from stdin: mainthing set --json -"
            body=$(cat)
            [[ -n "$body" ]] || fail "set --json -: nothing on stdin"
            call PUT "/tasks?source=$SOURCE" "$body" | titles
        else
            if [[ "${1-}" == "-" ]]; then
                lines=()
                while IFS= read -r line || [[ -n "$line" ]]; do lines+=("$line"); done
                set -- "${lines[@]+"${lines[@]}"}"
            fi
            call PUT "/tasks?source=$SOURCE" "$(json_array "$@")" | titles
        fi
        ;;
    done)
        shift
        take_source "$@"
        if [[ ${#REST[@]} -eq 0 ]]; then
            call POST "/tasks/done?source=$SOURCE" | titles
        elif [[ ${#REST[@]} -eq 1 && "${REST[0]}" =~ ^[1-9][0-9]*$ ]]; then
            call POST "/tasks/done?source=$SOURCE" "{\"index\":$(( REST[0] - 1 ))}" | titles
        else
            fail "done takes nothing or a task number from 1. Try: mainthing done, mainthing done 3, mainthing done --source agent"
        fi
        ;;
    adapters)
        call GET /status | installed adapters
        ;;
    hooks)
        call GET /status | installed hooks
        ;;
    health)
        call GET /health
        echo
        ;;
    version)
        # The running app answers. Otherwise the bundle this command sits in, when it does.
        if body=$(call GET /health 2>/dev/null); then
            printf '%s\n' "$body" | /usr/bin/sed -E 's/.*"version":"([^"]*)".*/\1/'
        else
            plist="$(cd "$(dirname "$(readlink -f "$0")")/.." 2>/dev/null && pwd)/Info.plist"
            [[ -f "$plist" ]] || fail "Main Thing is not running"
            /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$plist"
        fi
        ;;
    logs)
        exec /usr/bin/log stream --predicate "subsystem == \"$BUNDLE_ID\"" --style compact
        ;;
    port)
        case "${2-}" in
            "")
                pinned=$(pinned_port)
                echo "setting: ${pinned:-auto (80, then 7788)}"
                if call GET /health >/dev/null 2>&1; then
                    # The port is in the base URL that answered; none there means 80.
                    running="${BASE#http://$HOST}"
                    echo "running on port ${running:-:80}" | /usr/bin/sed 's/port :/port /'
                else
                    echo "not running"
                fi
                ;;
            auto)
                defaults delete "$BUNDLE_ID" port >/dev/null 2>&1 || true
                echo "port set to auto: 80, then 7788. Relaunch Main Thing to apply."
                ;;
            *)
                [[ "$2" =~ ^[0-9]+$ && "$2" -ge 1 && "$2" -le 65535 ]] || fail "port takes a number from 1 to 65535, or auto"
                defaults write "$BUNDLE_ID" port -int "$2"
                echo "port set to $2. Relaunch Main Thing to apply."
                ;;
        esac
        ;;
    -h|--help|help)
        help
        ;;
    *)
        fail "unknown command '$cmd'. Try: mainthing help"
        ;;
esac
